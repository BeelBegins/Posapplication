#!/usr/bin/env bash
set -euo pipefail

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "$local_ref" == "refs/heads/main" || "$remote_ref" == "refs/heads/main" ]]; then
    if [[ "${AIMATIC_RELEASE_CONFIRMED:-}" != "ALL_PRODUCTS_VERSIONED_AND_VERIFIED" ]]; then
      echo "BLOCKED: pushing Posapplication main publishes all products." >&2
      echo "Complete the versioned release gate, then set:" >&2
      echo "AIMATIC_RELEASE_CONFIRMED=ALL_PRODUCTS_VERSIONED_AND_VERIFIED" >&2
      exit 1
    fi
  fi
done
